# Copy to .env and edit, or just export these in your shell.
# Every value has a working default — nothing here is required.
# Defaults live in app/config.py.

# --- Where your data lives -------------------------------------------------
# Both default to the gitignored data/ folder. Point them elsewhere only if
# you know why (e.g. a NAS mount). Keep them together.
# INTERNSTASH_DATA_DIR=/absolute/path/to/data
# INTERNSTASH_DB_PATH=/absolute/path/to/data/internstash.db

# --- Server ----------------------------------------------------------------
# 0.0.0.0 makes the app reachable from other devices on your tailnet.
# There is NO AUTH — do not bind this to a public interface.
# INTERNSTASH_HOST=0.0.0.0
# INTERNSTASH_PORT=1337

# --- Scheduled feed import -------------------------------------------------
# Poll interval in minutes. Set to 0 to disable the background loop; you can
# still import on demand with the "Fetch feed" button.
# INTERNSTASH_FETCH_INTERVAL_MINUTES=360

# Run one import a few seconds after startup.
# INTERNSTASH_FETCH_ON_STARTUP=1

# Case-insensitive substring match on company + title + category + skills.
# "bio" intentionally matches biotech / biomedical / bioinformatics.
# Leave empty to import everything.
# INTERNSTASH_FETCH_KEYWORDS=python,machine learning,health,clinical,bio

# Case-insensitive substring match against the role title only. A match here
# means "never suggest this" -- overrides FETCH_KEYWORDS above. Applied at
# fetch time and retroactively against anything still in 'suggested'.
# INTERNSTASH_FETCH_EXCLUDE_KEYWORDS=phd

# INTERNSTASH_FEED_URL=https://zshah101.github.io/Automated-List-Of-Summer-2027-and-Fall-2026-Tech-Internships/api/jobs.json
# INTERNSTASH_FEED_URL_VANSHB03=https://raw.githubusercontent.com/vanshb03/Summer2027-Internships/dev/.github/scripts/listings.json
# INTERNSTASH_FETCH_TIMEOUT_SECONDS=30

# --- Local LLM autofill (optional) -----------------------------------------
# Paste a job description and have company / role / deadline / tags filled in
# by a LOCAL Ollama model. Nothing leaves your machine.
#
# Entirely optional — with Ollama absent, the autofill button simply doesn't
# appear and everything else works as normal.
#
# Set to 0 to turn the feature off even when Ollama is installed.
# INTERNSTASH_OLLAMA_ENABLED=1
# INTERNSTASH_OLLAMA_URL=http://127.0.0.1:11434
# INTERNSTASH_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# First extraction after a cold start pays a model-load penalty (~10s);
# warm calls land around 1-2s.
# INTERNSTASH_OLLAMA_TIMEOUT_SECONDS=90
# INTERNSTASH_OLLAMA_KEEP_ALIVE=15m
# INTERNSTASH_OLLAMA_NUM_CTX=8192
# INTERNSTASH_OLLAMA_MAX_CHARS=6000
